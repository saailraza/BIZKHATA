# ======== BIZKHATA settings: copy this file to ".env" and edit ========
HOST=127.0.0.1
PORT=8000

# postgres (live)   or   sqlite (only for quick testing on your own PC)
DB_ENGINE=postgres

# This is the MASTER database (admins, shop list, users, bills).
# Every shop additionally gets its OWN database named bk_<shop id>, so the user below needs the CREATEDB right:
#     sudo -u postgres psql -c "ALTER USER bizkhata CREATEDB;"
DATABASE_URL=postgresql://bizkhata:CHANGE_THIS_PASSWORD@localhost:5432/bizkhata_master

# database  = every shop gets its own DATABASE (default, strongest separation)
# schema    = every shop gets its own SCHEMA inside the master database
#             (use ONLY if your hosting does not allow CREATE DATABASE)
# Render Postgres: set SHOP_ISOLATION=schema  (Render DB user usually cannot CREATE DATABASE)
SHOP_ISOLATION=database

# Long random text used to sign login tokens. Make one with:  python -c "import secrets;print(secrets.token_hex(48))"
SECRET=

# Behind Nginx / Cloudflare set this to 1 so the real visitor IP is used for the login-attempt limit
TRUST_PROXY=1

# First admin (created once, on first start). Change the password after you log in.
ADMIN_LOGIN=admin@bizease.com
ADMIN_PASSWORD=ChangeMe-123456

# Connection tuning (PostgreSQL default max_connections is 100)
MAX_OPEN_SHOPS=10
DB_POOL_SHOP=2
DB_POOL_MASTER=6

# Only for sqlite testing
DATA_DIR=./data

# ======== Android app / Play Store (see APP_GUIDE.md) ========
# Package name of the Android app (must match android-app/gradle.properties)
ANDROID_PACKAGE=com.bizease.bizkhata
# SHA-256 certificate fingerprint(s) of the app signing key (Play Console > App integrity). Several allowed, comma separated.
ANDROID_SHA256=
# Link of the app on Google Play. When set, the website shows a "Get the Android app" link on the login page.
PLAY_STORE_URL=
# 1 = shopkeepers can upload bank slips inside the app (what you asked for).
# 0 = inside the Android app the Pay button sends them to the website instead (safer for Google Play's payment policy).
APP_ALLOW_PAYMENT=1

# ======== Fixed TEST account ========
# 1 = a ready test shop exists:  login  biztest   password  Test@1234   (always active, same data in every browser)
# Use it while testing. Set 0 before real users arrive and delete "Test Shop" in the admin panel.
TEST_USER=1

# ======== Frontend (optional) ========
# Production: Flask serves public/index.html + /api on the SAME origin — leave CORS empty.
# Separate frontend (e.g. Live Server / another port): comma-separated browser origins allowed to call /api.
# Example: CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Then in the frontend page set:  window.BIZKHATA_API = 'http://127.0.0.1:8000'
CORS_ORIGINS=
