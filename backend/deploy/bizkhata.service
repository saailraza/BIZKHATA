# /etc/systemd/system/bizkhata.service
[Unit]
Description=BIZKHATA (gunicorn)
After=network.target postgresql.service

[Service]
User=bizkhata
Group=bizkhata
WorkingDirectory=/opt/bizkhata
Environment="PATH=/opt/bizkhata/venv/bin"
ExecStart=/opt/bizkhata/venv/bin/gunicorn -c deploy/gunicorn.conf.py wsgi:application
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
